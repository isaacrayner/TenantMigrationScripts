## DESCRIPTION: Recreates all private endpoints in the destination subscription from the JSON
##              backup files produced by 10-BackupPrivateEndpoints.azcli.
## USAGE:       1. Update the subscription ID in az account set.
##              2. Update BACKUP_DIR to point to the folder containing the backup JSON files.
##              3. Run in WSL/bash with Azure CLI and jq installed and authenticated.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "$SCRIPT_DIR/../migration-params.sh"

az account set --subscription "$DESTINATION_SUBSCRIPTION_ID"

# Set backup file path
BACKUP_DIR="/mnt/c/temp/AzurePrivateEndpointsBackup/"

# Loop through all JSON files in /mnt/c/temp/
for file in "$BACKUP_DIR"*.json; do
    name=$(jq -r '.name' "$file")
    rg=$(jq -r '.resourceGroup' "$file")
    location=$(jq -r '.location' "$file")
    subnet_id=$(jq -r '.subnet.id' "$file")
    private_link_service_id=$(jq -r '.privateLinkServiceConnections[0].privateLinkServiceId' "$file")
    group_ids=$(jq -r '.privateLinkServiceConnections[0].groupIds | join(" ")' "$file")

    echo "Recreating Private Endpoint: $name"

    az network private-endpoint create \
        --name "$name" \
        --resource-group "$rg" \
        --location "$location" \
        --subnet "$subnet_id" \
        --private-connection-resource-id "$private_link_service_id" \
        --group-id "$group_ids" \
        --connection-name "${name}-connection"

    echo "Private Endpoint $name recreated."
done

echo "All Private Endpoints have been recreated!"
